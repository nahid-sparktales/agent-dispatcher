{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Dispatcher E2E Fixture Manifest v1",
  "type": "object",
  "required": ["schema_version", "fixtures"],
  "properties": {
    "schema_version": {"const": 1},
    "description": {"type": "string"},
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "prompt", "source_dir", "smoke", "human_required", "acceptance", "rubric", "checks"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "category": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "source_dir": {"type": "string", "minLength": 1},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600, "default": 600},
          "smoke": {"type": "boolean"},
          "human_required": {"type": "boolean"},
          "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "rubric": {
            "type": "object",
            "required": ["correctness", "completeness", "scope", "unsupported_claims", "unnecessary_intervention"],
            "properties": {
              "correctness": {"type": "string"},
              "completeness": {"type": "string"},
              "scope": {"type": "string"},
              "unsupported_claims": {"type": "string"},
              "unnecessary_intervention": {"type": "string"}
            },
            "additionalProperties": false
          },
          "references_dir": {"type": "string"},
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {"type": "object", "required": ["name", "kind", "script"], "properties": {"name": {"type": "string"}, "kind": {"const": "python"}, "script": {"type": "string"}}},
                {"type": "object", "required": ["name", "kind", "paths"], "properties": {"name": {"type": "string"}, "kind": {"enum": ["unchanged", "required_files"]}, "paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "no_extra_files": {"type": "boolean"}}}
              ]
            }
          }
        }
      }
    }
  }
}
